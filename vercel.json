{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/products/hospital-doors",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/es",
      "destination": "/es/puertas-para-proyectos",
      "permanent": true
    },
    {
      "source": "/ru",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/factory",
      "destination": "/about#factory",
      "permanent": true
    },
    {
      "source": "/applications/hotel-door-package-supplier",
      "destination": "/products/hotel-doors",
      "permanent": true
    },
    {
      "source": "/solutions/hotel-hospitality",
      "destination": "/products/hotel-doors",
      "permanent": true
    }
  ]
}
